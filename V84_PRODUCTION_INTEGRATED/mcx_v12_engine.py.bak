@dataclass
class MCXStrategyProfile:
    min_score: float
    min_expected_r: float
    max_extension_atr: float
    min_volume_expansion: float
    min_acceptance: float


@dataclass
class MCXConfig:
    # Session windows (IST)
    morning_open: dtime = dtime(9, 0)
    morning_orb_end: dtime = dtime(9, 15)
    morning_close: dtime = dtime(15, 30)
    evening_open: dtime = dtime(17, 0)
    evening_orb_end: dtime = dtime(17, 15)
    us_open_start: dtime = dtime(19, 30)
    us_open_end: dtime = dtime(20, 30)
    evening_entry_cutoff: dtime = dtime(22, 15)
    evening_close: dtime = dtime(23, 30)
    late_session_start: dtime = dtime(22, 0)

    # Scoring
    min_discovery_score: float = 55.0
    min_calibrated_score: float = 60.0
    min_remaining_edge_pct: float = 0.40
    max_signal_age_seconds: float = 5.0
    max_entry_drift_pct: float = 0.20
    orb_bars: int = 15

    # Extension tiers
    fresh_max_atr: float = 0.5
    extended_max_atr: float = 0.8
    continuation_max_atr: float = 1.5

    # Position management
    protect_at_r: float = 0.50
    trail_at_r: float = 1.00
    giveback_fraction: float = 0.35
    no_progress_minutes: int = 45
    min_momentum_for_hold: float = 45.0
    min_progress_r_after_decay: float = 0.15

    # Execution quality
    max_quote_age_seconds: float = 2.0
    max_spread_ticks: float = 3.0
    max_slippage_ticks: float = 2.0
    min_depth_ratio: float = 1.0
    reject_expiry_day_after_hour: int = 18

    # Risk
    max_positions: int = 3
    per_trade_risk_pct: float = 0.40
    max_portfolio_risk_pct: float = 1.20
    capital: float = 200000.0
    reserve_pct: float = 20.0

    # Rate limits
    ltp_min_interval: float = 1.05
    data_min_interval: float = 0.25
    max_consecutive_429: int = 3
    backoff_base: float = 2.0

    # Scan
    scan_interval_seconds: float = 30.0

    # Strategy profiles
    profiles: Dict[str, MCXStrategyProfile] = field(default_factory=lambda: {
        "ORB_BREAKOUT":           MCXStrategyProfile(65.0, 1.5, 0.8, 1.50, 0.65),
        "MOMENTUM_CONTINUATION":  MCXStrategyProfile(65.0, 2.0, 1.0, 1.30, 0.60),
        "PULLBACK_ENTRY":         MCXStrategyProfile(60.0, 1.8, 1.2, 1.15, 0.60),
        "VWAP_RECLAIM":           MCXStrategyProfile(60.0, 1.5, 1.2, 1.20, 0.65),
        "US_OPEN_REACTION":       MCXStrategyProfile(62.0, 1.5, 1.0, 1.30, 0.60),
    })

    allowed_symbols: Tuple[str, ...] = (
        "CRUDEOIL", "GOLD", "GOLDPETAL", "SILVER",
        "SILVERM", "NATURALGAS", "NATGASMINI",
    )

    live: bool = False
    version: str = "MCX_V12_ENGINE_2026_08_31"


# ============================================================================
# 3. SESSION MANAGER
# ============================================================================

class MCXSessionManager:
    """Determines current session state from IST time."""

    def __init__(self, config: MCXConfig):
        self.cfg = config
        self.state = SessionState.PRE_OPEN
        self._last_state = None

    def update(self) -> SessionState:
        t = _ist_time()
        prev = self.state

        if t < self.cfg.morning_open:
            self.state = SessionState.PRE_OPEN
        elif t < self.cfg.morning_orb_end:
            self.state = SessionState.MORNING_ORB
        elif t < dtime(12, 0):
            self.state = SessionState.MORNING_ACTIVE
        elif t < self.cfg.morning_close:
            self.state = SessionState.AFTERNOON_SELECTIVE
        elif t < self.cfg.evening_open:
            self.state = SessionState.EVENING_PRE
        elif t < self.cfg.evening_orb_end:
            self.state = SessionState.EVENING_ORB
        elif t < self.cfg.late_session_start:
            self.state = SessionState.EVENING_ACTIVE
        elif t < self.cfg.evening_close:
            self.state = SessionState.LATE_SESSION
        else:
            self.state = SessionState.CLOSED

        if self.state != prev:
            self._last_state = prev
        return self.state

    @property
    def is_orb_window(self) -> bool:
        return self.state in (SessionState.MORNING_ORB, SessionState.EVENING_ORB)

    @property
    def is_active(self) -> bool:
        return self.state not in (SessionState.PRE_OPEN, SessionState.CLOSED,
                                  SessionState.EVENING_PRE)

    @property
    def is_entry_allowed(self) -> bool:
        return self.state in (
            SessionState.MORNING_ORB, SessionState.MORNING_ACTIVE,
            SessionState.AFTERNOON_SELECTIVE,
            SessionState.EVENING_ORB, SessionState.EVENING_ACTIVE,
        )

    @property
    def is_us_open_window(self) -> bool:
        t = _ist_time()
        return self.cfg.us_open_start <= t < self.cfg.us_open_end

    def allowed_strategies(self) -> List[MCXStrategy]:
        s = self.state
        if s in (SessionState.MORNING_ORB, SessionState.EVENING_ORB):
            return [MCXStrategy.ORB_BREAKOUT]
        if s in (SessionState.MORNING_ACTIVE, SessionState.EVENING_ACTIVE):
            out = [MCXStrategy.ORB_BREAKOUT, MCXStrategy.MOMENTUM_CONTINUATION,
                   MCXStrategy.PULLBACK_ENTRY, MCXStrategy.VWAP_RECLAIM]
            if self.is_us_open_window:
                out.append(MCXStrategy.US_OPEN_REACTION)
            return out
        if s == SessionState.AFTERNOON_SELECTIVE:
            return [MCXStrategy.MOMENTUM_CONTINUATION, MCXStrategy.PULLBACK_ENTRY]
        if s == SessionState.LATE_SESSION:
            return []  # manage only
        return []


# ============================================================================
# 4. CONTRACT MANAGEMENT
# ============================================================================

class MCXContractResolver:
    """Validates contracts using V12 rules. Works with NativeMCXData outputs."""

    def __init__(self, config: MCXConfig):
        self.cfg = config

    def validate(self, contract_info: Dict[str, Any]) -> Tuple[bool, str]:
        """Validate a single contract dict from scrip master."""
        symbol = str(contract_info.get("symbol", "")).upper()
        inst = str(contract_info.get("instrument_type", contract_info.get("SEM_INSTRUMENT_NAME", ""))).upper()
        opt = str(contract_info.get("option_type", "")).upper()
        seg = str(contract_info.get("exchange_segment", "MCX_COMM")).upper()

        if "MCX" not in seg:
            return False, "MCX_SEGMENT_MISMATCH"
        if inst != "FUTCOM":
            return False, "NOT_MCX_FUTURE"
        if opt in ("CE", "PE"):
            return False, "OPTION_CONTRACT_REJECTED"
        if re.search(r'\d+(CE|PE)$', symbol):
            return False, "OPTION_SYMBOL_REJECTED"

        now_h = _ist_now().hour
        expiry_str = str(contract_info.get("expiry", ""))
        is_expiry_today = False
        try:
            exp_date = datetime.strptime(expiry_str[:10], "%Y-%m-%d").date()
            is_expiry_today = (exp_date == date.today())
        except Exception:
            pass

        if is_expiry_today and now_h >= self.cfg.reject_expiry_day_after_hour:
            return False, "EXPIRY_DAY_CONTRACT_REJECTED"

        return True, "OK"

    def get_commodity_params(self, key: str) -> Dict[str, Any]:
        return COMMODITY_PARAMS.get(key.upper(), {
            "lot_size": 1, "tick_size": 0.05, "margin": 50000
        })


# ============================================================================
# 5. DATA MANAGER (candle construction + health tracking)
# ============================================================================

@dataclass
class QuoteState:
    security_id: str
    last_price: float = 0.0
    last_update: float = 0.0  # monotonic
    bid: float = 0.0
    ask: float = 0.0
    volume: float = 0.0
    candles_1m: List[Dict] = field(default_factory=list)
    candles_5m: List[Dict] = field(default_factory=list)
    candles_15m: List[Dict] = field(default_factory=list)
    orb_high: float = 0.0
    orb_low: float = 0.0
    orb_complete: bool = False
    tod_volume_history: List[float] = field(default_factory=list)


class MCXDataManager:
    """Manages quote state, candle construction, and data health."""

    def __init__(self, config: MCXConfig):
        self.cfg = config
        self.quotes: Dict[str, QuoteState] = {}
        self._consecutive_429 = 0
        self._circuit_breaker_until = 0.0
        self._last_ltp_call = 0.0

    def register_contract(self, key: str, security_id: str):
        self.quotes[key] = QuoteState(security_id=security_id)

    def update_prices(self, raw_response: Dict[str, Any]) -> Dict[str, float]:
        """Parse Dhan response and update quote states. Returns {key: price}."""
        if _V12_AVAILABLE:
            parsed = parse_dhan_mcx_ltp(raw_response)
        else:
            data = raw_response.get("data", {})
            parsed = data.get("MCX_COMM", {}) if isinstance(data, dict) else {}

        now = time.monotonic()
        prices = {}
        for key, qs in self.quotes.items():
            sid = qs.security_id
            quote = parsed.get(str(sid), parsed.get(sid, {}))
            if isinstance(quote, dict) and "last_price" in quote:
                px = _num(quote["last_price"])
                if px and px > 0:
                    qs.last_price = px
                    qs.last_update = now
                    qs.volume = float(quote.get("volume", qs.volume))
                    qs.bid = float(quote.get("bid_price", quote.get("best_bid", qs.bid)))
                    qs.ask = float(quote.get("ask_price", quote.get("best_ask", qs.ask)))
                    prices[key] = px
                    self._update_candle(qs, px, qs.volume)
        self._consecutive_429 = 0
        return prices

    def _update_candle(self, qs: QuoteState, price: float, volume: float):
        """Append to 1m candle (simple OHLCV aggregation)."""
        now = _ist_now()
        minute_key = now.strftime("%H:%M")
        if not qs.candles_1m or qs.candles_1m[-1].get("minute") != minute_key:
            qs.candles_1m.append({
                "minute": minute_key, "open": price, "high": price,
                "low": price, "close": price, "volume": volume,
            })
        else:
            c = qs.candles_1m[-1]
            c["high"] = max(c["high"], price)
            c["low"] = min(c["low"], price)
            c["close"] = price
            c["volume"] = volume

    def record_orb(self, key: str, orb_bars: int = 15) -> Optional[Tuple[float, float]]:
        qs = self.quotes.get(key)
        if not qs or len(qs.candles_1m) < orb_bars:
            return None
        bars = qs.candles_1m[:orb_bars]
        h = max(c["high"] for c in bars)
        lo = min(c["low"] for c in bars)
        qs.orb_high = h
        qs.orb_low = lo
        qs.orb_complete = True
        return h, lo

    def is_healthy(self, key: str, max_age: float = 5.0) -> bool:
        qs = self.quotes.get(key)
        if not qs or qs.last_price <= 0:
            return False
        return (time.monotonic() - qs.last_update) < max_age

    @property
    def circuit_breaker_active(self) -> bool:
        if self._circuit_breaker_until > time.monotonic():
            return True
        return False

    def report_429(self):
        self._consecutive_429 += 1
        if self._consecutive_429 >= self.cfg.max_consecutive_429:
            backoff = self.cfg.backoff_base ** self._consecutive_429
            self._circuit_breaker_until = time.monotonic() + min(backoff, 120)
            log.warning(f"MCX CIRCUIT BREAKER: {self._consecutive_429} consecutive 429s, "
                        f"backing off {backoff:.0f}s")

    def report_success(self):
        self._consecutive_429 = 0
        self._circuit_breaker_until = 0.0


# ============================================================================
# 6. MCX-SPECIFIC SCORER
# ============================================================================

def classify_extension(distance_atr: float, cfg: MCXConfig) -> ExtensionTier:
    if distance_atr < cfg.fresh_max_atr:
        return ExtensionTier.FRESH
    if distance_atr < cfg.extended_max_atr:
        return ExtensionTier.EXTENDED_TRADABLE
    if distance_atr < cfg.continuation_max_atr:
        return ExtensionTier.CONTINUATION_ONLY
    return ExtensionTier.EXHAUSTED


def atr14(candles: List[Dict]) -> float:
    """ATR-14 from 1m candle dicts."""
    if len(candles) < 15:
        return 0.0
    trs = []
    for i in range(1, len(candles)):
        h, lo, pc = candles[i]["high"], candles[i]["low"], candles[i - 1]["close"]
        trs.append(max(h - lo, abs(h - pc), abs(lo - pc)))
    return sum(trs[-14:]) / 14.0 if len(trs) >= 14 else 0.0


def vwap_calc(candles: List[Dict]) -> float:
    pv = vol = 0.0
    for c in candles:
        tp = (c["high"] + c["low"] + c["close"]) / 3.0
        v = max(0.0, c.get("volume", 0))
        pv += tp * v
        vol += v
    return pv / vol if vol > 0 else (candles[-1]["close"] if candles else 0.0)


def momentum_pct(candles: List[Dict], bars: int) -> float:
    if len(candles) <= bars:
        return 0.0
    old = candles[-(bars + 1)]["close"]
    return (candles[-1]["close"] - old) / old * 100.0 if old else 0.0


def rvol_tod(candles: List[Dict], tod_history: List[float]) -> float:
    """Time-of-day RVOL: current bar volume vs same-time historical average."""
    if not candles:
        return 0.0
    cur_vol = candles[-1].get("volume", 0)
    if tod_history and len(tod_history) >= 3:
        avg = sum(tod_history) / len(tod_history)
        return cur_vol / avg if avg > 0 else 0.0
    # Fallback: intraday RVOL (last 20 bars)
    if len(candles) < 5:
        return 0.0
    recent = [c.get("volume", 0) for c in candles[-21:-1]]
    avg = sum(recent) / len(recent) if recent else 0
    return cur_vol / avg if avg > 0 else 0.0


class MCXScorer:
    """MCX-specific scoring separate from NSE."""

    def __init__(self, config: MCXConfig):
        self.cfg = config

    def score(self, key: str, side: str, qs: QuoteState) -> Dict[str, Any]:
        """Compute full score snapshot for a contract."""
        px = qs.last_price
        candles = qs.candles_1m
        atr = atr14(candles)
        vw = vwap_calc(candles) if candles else 0.0
        mom5 = momentum_pct(candles, 5)
        mom15 = momentum_pct(candles, 15)
        rv = rvol_tod(candles, qs.tod_volume_history)

        # Extension
        ext_atr = 0.0
        if atr > 0 and qs.orb_complete:
            ref = qs.orb_high if side == "LONG" else qs.orb_low
            ext_atr = abs(px - ref) / atr
        tier = classify_extension(ext_atr, self.cfg)

        # Direction checks
        aligned = (px > vw) if side == "LONG" else (px < vw)
        breakout = False
        if qs.orb_complete:
            breakout = (px > qs.orb_high) if side == "LONG" else (px < qs.orb_low)
        mom_ok = (mom5 > 0 and mom15 > 0) if side == "LONG" else (mom5 < 0 and mom15 < 0)

        # Score components (0-100)
        if atr <= 0:
            return {"score": 0.0, "valid": False, "reason": "NO_ATR"}

        breakout_pts = 25.0 if breakout else 0.0
        vwap_pts = max(0, min(20.0, 20.0 * (1.0 - abs(px - vw) / (2 * atr))))
        mom_pts = max(0, min(20.0, 20.0 * (abs(mom5) + abs(mom15)) / 0.40))
        vol_pts = max(0, min(15.0, 15.0 * max(0, (rv - 1.0)) / 1.5))
        align_pts = 10.0 if aligned else 0.0
        confirm_pts = 5.0 if mom_ok else 0.0

        # Extension penalty — NO unconditional ORB exception
        ext_penalty = 0.0
        if tier == ExtensionTier.EXTENDED_TRADABLE:
            ext_penalty = 5.0
        elif tier == ExtensionTier.CONTINUATION_ONLY:
            ext_penalty = 15.0
            if not (rv >= 2.0 and abs(mom5) > 0.15):
                ext_penalty = 30.0  # heavy penalty without strong acceleration
        elif tier == ExtensionTier.EXHAUSTED:
            ext_penalty = 50.0  # effectively kills direct entry

        raw_score = breakout_pts + vwap_pts + mom_pts + vol_pts + align_pts + confirm_pts
        final_score = max(0.0, min(100.0, raw_score - ext_penalty))

        # Breakout acceptance: how well price held past breakout
        acceptance = 0.0
        if breakout and qs.orb_complete:
            ref = qs.orb_high if side == "LONG" else qs.orb_low
            acceptance = min(1.0, abs(px - ref) / max(atr * 0.3, 0.01))

        # Expected R
        stop_dist = atr * 0.5
        target_dist = atr * 2.0
        expected_r = target_dist / stop_dist if stop_dist > 0 else 0.0

        # Remaining edge
        remaining = 0.50
        if qs.orb_complete:
            ref = qs.orb_high if side == "LONG" else qs.orb_low
            moved = abs(px - ref)
            total = atr * 2.5
            remaining = max(0.0, min(1.0, 1.0 - moved / total)) if total > 0 else 0.0

        valid = breakout and mom_ok and tier != ExtensionTier.EXHAUSTED
        if tier == ExtensionTier.CONTINUATION_ONLY:
            valid = valid and rv >= 2.0 and abs(mom5) > 0.15

        return {
            "score": round(final_score, 2),
            "valid": valid,
            "side": side,
            "price": px,
            "atr": round(atr, 4),
            "vwap": round(vw, 4),
            "mom5": round(mom5, 4),
            "mom15": round(mom15, 4),
            "rvol": round(rv, 2),
            "extension_atr": round(ext_atr, 3),
            "extension_tier": tier.value,
            "breakout": breakout,
            "acceptance": round(acceptance, 3),
            "expected_r": round(expected_r, 2),
            "remaining_edge": round(remaining, 3),
            "orb_high": qs.orb_high,
            "orb_low": qs.orb_low,
            "components": {
                "breakout": breakout_pts, "vwap": round(vwap_pts, 1),
                "momentum": round(mom_pts, 1), "volume": round(vol_pts, 1),
                "alignment": align_pts, "confirmation": confirm_pts,
                "extension_penalty": round(ext_penalty, 1),
            },
        }


# ============================================================================
# 7. STRATEGY ROUTER
# ============================================================================

class MCXStrategyRouter:
    """Routes candidates to the best-matching strategy."""

    def __init__(self, config: MCXConfig):
        self.cfg = config

    def route(self, snapshot: Dict[str, Any], session: MCXSessionManager) -> Optional[MCXStrategy]:
        allowed = session.allowed_strategies()
        if not allowed:
            return None

        is_breakout = snapshot.get("breakout", False)
        tier = ExtensionTier(snapshot.get("extension_tier", "EXHAUSTED"))
        is_us = session.is_us_open_window

        if is_us and MCXStrategy.US_OPEN_REACTION in allowed:
            return MCXStrategy.US_OPEN_REACTION

        if is_breakout and tier in (ExtensionTier.FRESH, ExtensionTier.EXTENDED_TRADABLE):
            if MCXStrategy.ORB_BREAKOUT in allowed:
                return MCXStrategy.ORB_BREAKOUT

        if tier == ExtensionTier.EXHAUSTED:
            if MCXStrategy.PULLBACK_ENTRY in allowed:
                return MCXStrategy.PULLBACK_ENTRY
            return None  # no direct entry on exhausted

        if tier == ExtensionTier.CONTINUATION_ONLY:
            if MCXStrategy.MOMENTUM_CONTINUATION in allowed:
                return MCXStrategy.MOMENTUM_CONTINUATION
            return None

        if MCXStrategy.MOMENTUM_CONTINUATION in allowed:
            return MCXStrategy.MOMENTUM_CONTINUATION

        return None


# ============================================================================
# 8. ENTRY DECISION ENGINE (fail-closed)
# ============================================================================

MCX_CRITICAL_FEATURES = (
    "data_healthy", "execution_quality_ok", "signal_age_seconds",
    "entry_drift_pct", "volume_expansion", "expected_r", "remaining_edge_pct",
)


class MCXEntryEngine:
    """Fail-closed entry decision for MCX. Mirrors V12 NSE pattern."""

    def __init__(self, config: MCXConfig):
        self.cfg = config

    def evaluate(self, snapshot: Dict[str, Any], strategy: MCXStrategy,
                 features: Dict[str, Any]) -> Tuple[str, str, Dict]:
        """
        Returns (decision, reason, audit).
        decision: ENTER_NOW / WAIT / PULLBACK / CANCEL
        """
        profile = self.cfg.profiles.get(strategy.value)
        if not profile:
            return "CANCEL", "UNKNOWN_STRATEGY", {}

        audit = {
            "strategy": strategy.value,
            "side": snapshot.get("side"),
            "score": snapshot.get("score"),
            "extension_tier": snapshot.get("extension_tier"),
        }

        # Critical feature gate
        for feat in MCX_CRITICAL_FEATURES:
            v = _num(features.get(feat))
            if v is None:
                return "CANCEL", f"MISSING_CRITICAL:{feat}", audit

        if not features.get("data_healthy"):
            return "CANCEL", "STALE_DATA", audit
        if not features.get("execution_quality_ok"):
            return "CANCEL", "EXECUTION_QUALITY_REJECTED", audit

        sig_age = _num(features["signal_age_seconds"]) or 0
        if sig_age > self.cfg.max_signal_age_seconds:
            return "WAIT", "STALE_SIGNAL", audit

        drift = _num(features["entry_drift_pct"]) or 0
        if drift > self.cfg.max_entry_drift_pct:
            return "WAIT", "ENTRY_DRIFT", audit

        # Score gate
        score = snapshot.get("score", 0)
        if score < profile.min_score:
            return "WAIT", f"SCORE_LOW_{score:.0f}<{profile.min_score:.0f}", audit

        # Volume gate
        vol = _num(features["volume_expansion"]) or 0
        if vol < profile.min_volume_expansion:
            return "WAIT", "VOLUME_INSUFFICIENT", audit

        # Extension gate
        ext = snapshot.get("extension_atr", 0)
        if ext > profile.max_extension_atr:
            return "PULLBACK", f"EXTENSION_{ext:.2f}>{profile.max_extension_atr:.2f}", audit

        # Expected R gate
        exp_r = _num(features["expected_r"]) or 0
        if exp_r < profile.min_expected_r:
            return "WAIT", f"EXPECTED_R_{exp_r:.1f}<{profile.min_expected_r:.1f}", audit

        # Remaining edge
        edge = _num(features["remaining_edge_pct"]) or 0
        if edge < self.cfg.min_remaining_edge_pct:
            return "WAIT", "REMAINING_EDGE_LOW", audit

        # Acceptance gate (for breakout strategies)
        if strategy in (MCXStrategy.ORB_BREAKOUT, MCXStrategy.MOMENTUM_CONTINUATION):
            acc = snapshot.get("acceptance", 0)
            if acc < profile.min_acceptance:
                return "WAIT", "ACCEPTANCE_LOW", audit

        return "ENTER_NOW", "ALL_GATES_PASSED", audit


# ============================================================================
# 9. POSITION MANAGER
# ============================================================================

@dataclass
class MCXPosition:
    key: str
    symbol: str
    security_id: str
    side: str
    qty_lots: int
    lot_size: float
    entry: float
    initial_sl: float
    sl: float
    peak: float
    best_r: float
    entry_time: str
    status: str = "OPEN"
    state: str = "INITIAL"
    mfe: float = 0.0
    mae: float = 0.0
    exit_price: Optional[float] = None
    exit_reason: Optional[str] = None
    minutes_in_trade: float = 0.0


class MCXPositionManager:
    """Direction-safe position management with progressive protection."""

    def __init__(self, config: MCXConfig):
        self.cfg = config
        self.positions: Dict[str, MCXPosition] = {}

    def open_position(self, key: str, symbol: str, sid: str, side: str,
                      qty_lots: int, lot_size: float, entry: float, sl: float) -> MCXPosition:
        pos = MCXPosition(
            key=key, symbol=symbol, security_id=sid, side=side,
            qty_lots=qty_lots, lot_size=lot_size, entry=entry,
            initial_sl=sl, sl=sl, peak=entry, best_r=0.0,
            entry_time=_ist_now().isoformat(), status="OPEN",
        )
        self.positions[key] = pos
        return pos

    def update(self, pos: MCXPosition, px: float, mom_score: float = 50.0) -> Tuple[str, str, Dict]:
        """Returns (action, reason, metrics)."""
        if pos.status != "OPEN":
            return "HOLD", "CLOSED", {}

        risk = abs(pos.entry - pos.initial_sl)
        if risk <= 0:
            return "EXIT", "ZERO_RISK", {}

        # Direction-safe R
        if pos.side == "LONG":
            pos.peak = max(pos.peak, px)
            cur_r = (px - pos.entry) / risk
            peak_r = (pos.peak - pos.entry) / risk
            pos.mfe = max(pos.mfe, (pos.peak - pos.entry) / pos.entry * 100)
            pos.mae = max(pos.mae, max(0, (pos.entry - px) / pos.entry * 100))
        else:
            pos.peak = min(pos.peak, px)
            cur_r = (pos.entry - px) / risk
            peak_r = (pos.entry - pos.peak) / risk
            pos.mfe = max(pos.mfe, (pos.entry - pos.peak) / pos.entry * 100)
            pos.mae = max(pos.mae, max(0, (px - pos.entry) / pos.entry * 100))

        pos.best_r = max(pos.best_r, peak_r)
        giveback = max(0.0, peak_r - cur_r)

        # State labels
        if peak_r >= 2.0:
            pos.state = PositionState.RUNNER.value
        elif peak_r >= 1.0:
            pos.state = PositionState.PROFIT.value
        elif peak_r >= 0.3:
            pos.state = PositionState.PROVEN.value
        else:
            pos.state = PositionState.INITIAL.value

        metrics = {"current_r": round(cur_r, 3), "peak_r": round(peak_r, 3),
                    "giveback": round(giveback, 3), "state": pos.state,
                    "mfe_pct": round(pos.mfe, 2), "mae_pct": round(pos.mae, 2)}

        # SL hit
        if pos.side == "LONG" and px <= pos.sl:
            return "EXIT", "SL_HIT", metrics
        if pos.side == "SHORT" and px >= pos.sl:
            return "EXIT", "SL_HIT", metrics

        # Time decay
        elapsed = pos.minutes_in_trade
        if (elapsed >= self.cfg.no_progress_minutes
                and cur_r < self.cfg.min_progress_r_after_decay
                and mom_score < self.cfg.min_momentum_for_hold):
            return "EXIT", "TIME_DECAY", metrics

        # Trail / protect
        if peak_r >= self.cfg.trail_at_r:
            allowed = max(0.25, peak_r * self.cfg.giveback_fraction)
            if giveback >= allowed and mom_score < self.cfg.min_momentum_for_hold:
                return "EXIT", "EXCESSIVE_GIVEBACK", metrics

            # Calculate new SL
            new_sl = self._compute_trail_sl(pos, peak_r, risk, px)
            if new_sl is not None:
                if (pos.side == "LONG" and new_sl > pos.sl) or \
                   (pos.side == "SHORT" and new_sl < pos.sl):
                    pos.sl = new_sl
                    return "UPDATE_SL", "TRAIL", metrics
            return "HOLD", "TRAILING", metrics

        if peak_r >= self.cfg.protect_at_r:
            return "HOLD", "PROTECTING", metrics

        return "HOLD", "FORMING", metrics

    def _compute_trail_sl(self, pos: MCXPosition, peak_r: float,
                          risk: float, px: float) -> Optional[float]:
        """Progressive R milestones: 1R→0.5, 2R→1.25, 2.5R→1.75, 3R→2.25"""
        if peak_r >= 3.0:
            protect = 2.25
        elif peak_r >= 2.5:
            protect = 1.75
        elif peak_r >= 2.0:
            protect = 1.25
        elif peak_r >= 1.0:
            protect = 0.50
        else:
            return None

        if pos.side == "LONG":
            return pos.entry + protect * risk
        return pos.entry - protect * risk


# ============================================================================
# 10. SAFETY GATE
# ============================================================================

class MCXSafetyGate:
    """Checks ALL conditions before allowing trading. Fail-closed."""

    def __init__(self, config: MCXConfig):
        self.cfg = config

    def can_trade(self, session: MCXSessionManager, data: MCXDataManager,
                  contracts: Dict[str, Any], positions: Dict) -> Tuple[bool, str]:
        if not session.is_entry_allowed:
            return False, f"SESSION_STATE:{session.state.value}"

        if data.circuit_breaker_active:
            return False, "CIRCUIT_BREAKER_ACTIVE"

        # Data health for all active contracts
        for key in contracts:
            if not data.is_healthy(key, self.cfg.max_quote_age_seconds * 2):
                return False, f"DATA_STALE:{key}"

        if len(positions) >= self.cfg.max_positions:
            return False, f"MAX_POSITIONS:{len(positions)}>={self.cfg.max_positions}"

        return True, "OK"


# ============================================================================
# 11. AUDIT LOGGER
# ============================================================================

class MCXAuditLogger:
    """JSONL audit log for MCX session."""

    def __init__(self, base_path: str = "mcx_v12_audit"):
        self._base = Path(base_path)
        self._base.mkdir(parents=True, exist_ok=True)
        self._lock = threading.Lock()
        self._file = None
        self._date = None

    def _writer(self):
        today = date.today().isoformat()
        if today != self._date:
            if self._file:
                try:
                    self._file.close()
                except Exception:
                    pass
            path = self._base / f"mcx_audit_{today}.jsonl"
            self._file = open(path, "a")
            self._date = today
        return self._file

    def log(self, event: AuditEvent, data: Dict[str, Any] = None):
        try:
            entry = {
                "ts": _ist_now().isoformat(),
                "event": event.value,
                **(data or {}),
            }
            with self._lock:
                w = self._writer()
                w.write(json.dumps(entry, default=str) + "\n")
                w.flush()
        except Exception as e:
            log.debug(f"Audit write error: {e}")

    def close(self):
        with self._lock:
            if self._file:
                try:
                    self._file.close()
                except Exception:
                    pass
                self._file = None


# ============================================================================
# 12. MAIN ENGINE
# ============================================================================

class MCXEngine:
    """
    Synchronous MCX V12 engine. Orchestrates session, data, scoring,
    entry decisions, position management, and audit.
    """

    def __init__(self, config: MCXConfig = None, data_provider=None, gateway=None):
        self.cfg = config or MCXConfig()
        self.data_provider = data_provider  # NativeMCXData instance
        self.gateway = gateway  # None for shadow
        self.session = MCXSessionManager(self.cfg)
        self.data = MCXDataManager(self.cfg)
        self.scorer = MCXScorer(self.cfg)
        self.router = MCXStrategyRouter(self.cfg)
        self.entry = MCXEntryEngine(self.cfg)
        self.positions = MCXPositionManager(self.cfg)
        self.safety = MCXSafetyGate(self.cfg)
        self.resolver = MCXContractResolver(self.cfg)
        self.audit = MCXAuditLogger()
        self.contracts: Dict[str, Any] = {}
        self._heartbeat_time = 0.0
        self._orb_recorded: Dict[str, bool] = {}

    def run(self, symbols: Dict[str, str], capital: float,
            available_contracts: Dict[str, Any]):
        """
        Main loop. Runs until session closes.

        Args:
            symbols: {"CRUDEOIL": "CRUDEOIL", ...} key→prefix map
            capital: virtual/real capital
            available_contracts: pre-resolved contract dicts
        """
        self.cfg.capital = capital
        log.info(f"MCX V12 ENGINE START (version={self.cfg.version}, "
                 f"live={self.cfg.live}, contracts={len(available_contracts)})")
        self.audit.log(AuditEvent.SESSION_START, {
            "version": self.cfg.version, "live": self.cfg.live,
            "capital": capital, "symbols": list(symbols.keys()),
        })

        # Validate and register contracts
        for key, contract in available_contracts.items():
            ok, reason = self.resolver.validate(contract if isinstance(contract, dict)
                                                else {"symbol": getattr(contract, "symbol", key),
                                                      "instrument_type": "FUTCOM",
                                                      "exchange_segment": "MCX_COMM",
                                                      "option_type": "",
                                                      "expiry": getattr(contract, "expiry", "")})
            if not ok:
                log.warning(f"MCX V12: Contract REJECTED {key}: {reason}")
                self.audit.log(AuditEvent.CONTRACT_REJECTED, {"key": key, "reason": reason})
                continue
            sid = contract.get("security_id") if isinstance(contract, dict) \
                  else getattr(contract, "security_id", None)
            if sid:
                self.contracts[key] = contract
                self.data.register_contract(key, str(sid))
                self.audit.log(AuditEvent.CONTRACT_RESOLVED, {"key": key, "sid": sid})

        if not self.contracts:
            log.error("MCX V12: No valid contracts. Exiting.")
            return

        log.info(f"MCX V12: {len(self.contracts)} contracts active: {list(self.contracts.keys())}")

        # Main loop
        while True:
            try:
                state = self.session.update()
                if state == SessionState.CLOSED:
                    self._handle_eod()
                    break
                if not self.session.is_active:
                    time.sleep(10)
                    continue

                self._scan_cycle()
                self._heartbeat()
                time.sleep(self.cfg.scan_interval_seconds)

            except KeyboardInterrupt:
                log.info("MCX V12: Interrupted")
                break
            except Exception as e:
                log.error(f"MCX V12: Cycle error: {e}")
                time.sleep(5)

        self.audit.log(AuditEvent.SESSION_END, {
            "positions_closed": len([p for p in self.positions.positions.values()
                                     if p.status == "CLOSED"]),
            "positions_open": len([p for p in self.positions.positions.values()
                                   if p.status == "OPEN"]),
        })
        self.audit.close()
        log.info("MCX V12 ENGINE END")

    def _scan_cycle(self):
        """One scan: LTP → candles → ORB → signals → positions."""
        # V12 FIX 2: Don't poll during first 60s of ORB window (ticks may be stale)
        if self.session.is_orb_window and not hasattr(self, '_orb_warmup_done'):
            import time as _t2
            if not hasattr(self, '_orb_window_entered_at'):
                self._orb_window_entered_at = _t2.monotonic()
                log.info("MCX V12: ORB window entered, warming up 60s before first poll")
                return
            if (_t2.monotonic() - self._orb_window_entered_at) < 60:
                return  # still warming up
            self._orb_warmup_done = True
            log.info("MCX V12: Warm-up complete, starting LTP polling")
        if self.data.circuit_breaker_active:
            log.info("MCX V12: Circuit breaker active, skipping scan")
            return

        # Fetch LTP
        if self.data_provider:
            sids = [self.data.quotes[k].security_id for k in self.contracts
                    if k in self.data.quotes]
            try:
                raw = self.data_provider.marketfeed_ltp(sids)
                # Wrap in expected Dhan response format
                if isinstance(raw, dict) and "data" not in raw:
                    raw = {"data": {"MCX_COMM": raw}}
                prices = self.data.update_prices(raw)
                self.data.report_success()
                # V12 FIX 1: Response logging for diagnostics
                if prices:
                    _sample = list(prices.items())[:2]
                    log.info(f"MCX V12 LTP OK: {len(prices)} prices parsed. Sample: {_sample}")
                else:
                    log.warning(f"MCX V12 LTP EMPTY: API returned data but 0 prices parsed. raw_keys={list(raw.get('data',{}).get('MCX_COMM',{}).keys())[:3] if isinstance(raw,dict) else 'not-dict'}")
                # V12 FIX 1: Response logging for diagnostics
                if prices:
                    _sample = list(prices.items())[:2]
                    log.info(f"MCX V12 LTP OK: {len(prices)} prices parsed. Sample: {_sample}")
                else:
                    log.warning(f"MCX V12 LTP EMPTY: API returned data but 0 prices parsed. raw_keys={list(raw.get('data',{}).get('MCX_COMM',{}).keys())[:3] if isinstance(raw,dict) else 'not-dict'}")
                # V12 FIX 1: Response logging for diagnostics
                if prices:
                    _sample = list(prices.items())[:2]
                    log.info(f"MCX V12 LTP OK: {len(prices)} prices parsed. Sample: {_sample}")
                else:
                    log.warning(f"MCX V12 LTP EMPTY: API returned data but 0 prices parsed. raw_keys={list(raw.get('data',{}).get('MCX_COMM',{}).keys())[:3] if isinstance(raw,dict) else 'not-dict'}")
            except RuntimeError as e:
                if "429" in str(e):
                    self.data.report_429()
                    self.audit.log(AuditEvent.CIRCUIT_BREAKER, {"error": str(e)})
                return
            except Exception as e:
                log.warning(f"MCX V12: LTP error: {e}")
                return
        else:
            return  # No data provider

        # Record ORB if in ORB window
        if self.session.is_orb_window:
            for key in self.contracts:
                if not self._orb_recorded.get(key):
                    result = self.data.record_orb(key, self.cfg.orb_bars)
                    if result:
                        h, lo = result
                        self._orb_recorded[key] = True
                        log.info(f"MCX V12: ORB {key}: H={h} L={lo}")
                        self.audit.log(AuditEvent.ORB_COMPLETE, {
                            "key": key, "orb_high": h, "orb_low": lo})

        # Evaluate signals
        for key in self.contracts:
            qs = self.data.quotes.get(key)
            if not qs or not qs.orb_complete:
                continue
            if not self.data.is_healthy(key):
                self.audit.log(AuditEvent.DATA_STALE, {"key": key})
                continue

            # Skip if already have position in this contract
            if key in self.positions.positions and \
               self.positions.positions[key].status == "OPEN":
                self._manage_position(key, qs)
                continue

            # Score both sides
            for side in ("LONG", "SHORT"):
                snap = self.scorer.score(key, side, qs)
                if not snap.get("valid"):
                    continue

                self.audit.log(AuditEvent.SIGNAL_DETECTED, {
                    "key": key, "side": side, "score": snap["score"],
                    "extension_tier": snap["extension_tier"],
                })

                # Route to strategy
                strategy = self.router.route(snap, self.session)
                if not strategy:
                    continue

                # Build features for entry engine
                features = {
                    "data_healthy": 1.0 if self.data.is_healthy(key) else 0.0,
                    "execution_quality_ok": 1.0,  # TODO: wire actual depth/spread
                    "signal_age_seconds": 0.0,
                    "entry_drift_pct": 0.0,
                    "volume_expansion": snap["rvol"],
                    "expected_r": snap["expected_r"],
                    "remaining_edge_pct": snap["remaining_edge"],
                }

                decision, reason, audit_data = self.entry.evaluate(snap, strategy, features)

                log.info(f"MCX V12: {key} {side} | {decision} | "
                         f"strategy={strategy.value} score={snap['score']:.1f} "
                         f"ext={snap['extension_atr']:.2f}({snap['extension_tier']}) "
                         f"R={snap['expected_r']:.1f} | {reason}")

                self.audit.log(AuditEvent.ENTRY_DECISION, {
                    "key": key, "side": side, "decision": decision,
                    "strategy": strategy.value, "score": snap["score"],
                    "reason": reason, **audit_data,
                })

                if decision == "ENTER_NOW":
                    self._execute_entry(key, side, snap, strategy)

    def _manage_position(self, key: str, qs: QuoteState):
        """Update existing position."""
        pos = self.positions.positions.get(key)
        if not pos or pos.status != "OPEN":
            return

        px = qs.last_price
        # Update time
        try:
            entry_dt = datetime.fromisoformat(pos.entry_time)
            pos.minutes_in_trade = (_ist_now() - entry_dt).total_seconds() / 60.0
        except Exception:
            pass

        action, reason, metrics = self.positions.update(pos, px)

        if action == "EXIT":
            pos.status = "CLOSED"
            pos.exit_price = px
            pos.exit_reason = reason
            log.info(f"MCX V12: EXIT {key} {pos.side} @ {px} | {reason} | {metrics}")
            self.audit.log(AuditEvent.EXIT_SIGNAL, {
                "key": key, "side": pos.side, "price": px,
                "reason": reason, **metrics,
            })
        elif action == "UPDATE_SL":
            log.info(f"MCX V12: TRAIL {key} {pos.side} SL→{pos.sl:.2f} | {metrics}")
            self.audit.log(AuditEvent.TRAIL_UPDATED, {
                "key": key, "new_sl": pos.sl, **metrics,
            })

    def _execute_entry(self, key: str, side: str, snap: Dict, strategy: MCXStrategy):
        """Execute or shadow-log an entry."""
        can, reason = self.safety.can_trade(
            self.session, self.data, self.contracts, self.positions.positions)
        if not can:
            log.info(f"MCX V12: Entry blocked for {key}: {reason}")
            return

        params = self.resolver.get_commodity_params(key)
        atr = snap["atr"]
        px = snap["price"]
        sl = px - atr * 0.5 if side == "LONG" else px + atr * 0.5

        # Lot sizing
        risk_per_lot = abs(px - sl) * params["lot_size"]
        trade_risk = self.cfg.capital * self.cfg.per_trade_risk_pct / 100
        lots = max(0, int(trade_risk / risk_per_lot)) if risk_per_lot > 0 else 0

        if lots <= 0:
            log.info(f"MCX V12: {key} {side} — 0 lots (risk={risk_per_lot:.0f}/lot)")
            return

        if self.cfg.live and self.gateway:
            log.info(f"MCX V12: LIVE ENTRY {key} {side} {lots} lots @ {px} SL={sl:.2f}")
            # TODO: gateway.place_order(...)
        else:
            log.info(f"MCX V12: SHADOW ENTRY {key} {side} {lots} lots @ {px} "
                     f"SL={sl:.2f} strategy={strategy.value} score={snap['score']:.1f}")

        pos = self.positions.open_position(
            key, snap.get("symbol", key), snap.get("security_id", ""),
            side, lots, params["lot_size"], px, sl)

        self.audit.log(AuditEvent.POSITION_OPEN, {
            "key": key, "side": side, "lots": lots,
            "entry": px, "sl": sl, "strategy": strategy.value,
            "score": snap["score"], "live": self.cfg.live,
        })

    def _handle_eod(self):
        """Close all open positions at end of day."""
        for key, pos in self.positions.positions.items():
            if pos.status == "OPEN":
                qs = self.data.quotes.get(key)
                px = qs.last_price if qs else pos.entry
                pos.status = "CLOSED"
                pos.exit_price = px
                pos.exit_reason = "EOD"
                log.info(f"MCX V12: EOD CLOSE {key} {pos.side} @ {px}")
                self.audit.log(AuditEvent.POSITION_CLOSED, {
                    "key": key, "side": pos.side, "exit": px, "reason": "EOD"})

    def _heartbeat(self):
        now = time.monotonic()
        if now - self._heartbeat_time < 60:
            return
        self._heartbeat_time = now

        open_pos = [k for k, p in self.positions.positions.items() if p.status == "OPEN"]
        healthy = sum(1 for k in self.contracts if self.data.is_healthy(k))
        self.audit.log(AuditEvent.HEARTBEAT, {
            "session_state": self.session.state.value,
            "contracts_active": len(self.contracts),
            "data_healthy": healthy,
            "positions_open": len(open_pos),
            "circuit_breaker": self.data.circuit_breaker_active,
        })


# ============================================================================
# SELF-TESTS
# ============================================================================

if __name__ == "__main__":
    passed = failed = 0

    def check(name, cond, detail=""):
        global passed, failed
        if cond:
            passed += 1
            print(f"  ✅ {name}")
        else:
            failed += 1
            print(f"  ❌ {name}: {detail}")

    cfg = MCXConfig()

    # --- Session State Transitions ---
    print("=== Session Manager ===")
    sm = MCXSessionManager(cfg)
    # Test session routing based on time windows
    check("Config version", cfg.version == "MCX_V12_ENGINE_2026_08_31")
    check("Morning ORB strategies", MCXStrategy.ORB_BREAKOUT in sm.allowed_strategies()
          or sm.state == SessionState.PRE_OPEN)  # depends on current time
    check("Session has all states", len(SessionState) == 9)

    # --- Extension Tiers ---
    print("\n=== Extension Classification ===")
    check("FRESH < 0.5", classify_extension(0.3, cfg) == ExtensionTier.FRESH)
    check("EXTENDED 0.5-0.8", classify_extension(0.6, cfg) == ExtensionTier.EXTENDED_TRADABLE)
    check("CONTINUATION 0.8-1.5", classify_extension(1.2, cfg) == ExtensionTier.CONTINUATION_ONLY)
    check("EXHAUSTED > 1.5", classify_extension(2.0, cfg) == ExtensionTier.EXHAUSTED)

    # --- Contract Validation ---
    print("\n=== Contract Validation ===")
    resolver = MCXContractResolver(cfg)
    ok, _ = resolver.validate({"symbol": "CRUDEOIL", "instrument_type": "FUTCOM",
                                "exchange_segment": "MCX_COMM", "option_type": ""})
    check("Valid FUTCOM passes", ok)
    ok, msg = resolver.validate({"symbol": "GOLD-116000-CE", "instrument_type": "OPTCOM",
                                  "exchange_segment": "MCX_COMM", "option_type": "CE"})
    check("Option rejected", not ok)
    ok, msg = resolver.validate({"symbol": "CRUDEOIL", "instrument_type": "FUTCOM",
                                  "exchange_segment": "NSE_EQ", "option_type": ""})
    check("Wrong segment rejected", not ok)

    # --- Scorer ---
    print("\n=== Scoring ===")
    scorer = MCXScorer(cfg)
    qs = QuoteState(security_id="12345", last_price=7800.0, orb_high=7750.0,
                    orb_low=7700.0, orb_complete=True)
    # Build some candles
    for i in range(20):
        qs.candles_1m.append({
            "minute": f"17:{i:02d}", "open": 7700 + i * 5,
            "high": 7710 + i * 5, "low": 7695 + i * 5,
            "close": 7705 + i * 5, "volume": 1000 + i * 100,
        })
    snap = scorer.score("CRUDEOIL", "LONG", qs)
    check("Score computed", snap["score"] > 0, snap["score"])
    check("ATR computed", snap["atr"] > 0, snap["atr"])
    check("Has extension tier", snap["extension_tier"] in [t.value for t in ExtensionTier])
    check("Has expected_r", snap["expected_r"] > 0)
    check("Has remaining_edge", 0 <= snap["remaining_edge"] <= 1.0)

    # --- Entry Engine ---
    print("\n=== Entry Engine ===")
    entry_engine = MCXEntryEngine(cfg)

    # Good candidate
    good_snap = {"score": 72.0, "side": "LONG", "extension_atr": 0.3,
                 "extension_tier": "FRESH", "rvol": 2.0, "acceptance": 0.8,
                 "expected_r": 2.0, "remaining_edge": 0.55}
    good_feats = {"data_healthy": 1.0, "execution_quality_ok": 1.0,
                  "signal_age_seconds": 1.0, "entry_drift_pct": 0.05,
                  "volume_expansion": 2.0, "expected_r": 2.0, "remaining_edge_pct": 0.55}
    dec, reason, _ = entry_engine.evaluate(good_snap, MCXStrategy.ORB_BREAKOUT, good_feats)
    check("Good candidate → ENTER_NOW", dec == "ENTER_NOW", f"{dec}: {reason}")

    # Missing critical feature
    bad_feats = dict(good_feats)
    del bad_feats["data_healthy"]
    dec, reason, _ = entry_engine.evaluate(good_snap, MCXStrategy.ORB_BREAKOUT, bad_feats)
    check("Missing feature → CANCEL", dec == "CANCEL", f"{dec}: {reason}")

    # Stale data
    stale_feats = dict(good_feats)
    stale_feats["data_healthy"] = 0.0
    dec, reason, _ = entry_engine.evaluate(good_snap, MCXStrategy.ORB_BREAKOUT, stale_feats)
    check("Stale data → CANCEL", dec == "CANCEL", f"{dec}: {reason}")

    # Low score
    low_snap = dict(good_snap)
    low_snap["score"] = 40.0
    dec, reason, _ = entry_engine.evaluate(low_snap, MCXStrategy.ORB_BREAKOUT, good_feats)
    check("Low score → WAIT", dec == "WAIT", f"{dec}: {reason}")

    # Extended → PULLBACK
    ext_snap = dict(good_snap)
    ext_snap["extension_atr"] = 2.0
    dec, reason, _ = entry_engine.evaluate(ext_snap, MCXStrategy.ORB_BREAKOUT, good_feats)
    check("Extended → PULLBACK", dec == "PULLBACK", f"{dec}: {reason}")

    # --- Position Manager ---
    print("\n=== Position Management ===")
    pm = MCXPositionManager(cfg)

    # LONG position
    pos = pm.open_position("GOLD", "GOLD", "123", "LONG", 1, 100, 50000.0, 49500.0)
    action, reason, m = pm.update(pos, 50800.0)
    check("LONG trail after profit", action in ("UPDATE_SL", "HOLD"), f"{action}: {reason}")
    check("LONG peak updated", pos.peak == 50800.0)

    action, reason, m = pm.update(pos, 49400.0)
    check("LONG SL hit → EXIT", action == "EXIT")

    # SHORT position
    pos2 = pm.open_position("SILVER", "SILVER", "456", "SHORT", 1, 30, 80000.0, 80500.0)
    action, reason, m = pm.update(pos2, 79200.0)
    check("SHORT profit tracked", m["current_r"] > 0, m.get("current_r"))
    check("SHORT peak tracks downward", pos2.peak == 79200.0)

    action, reason, m = pm.update(pos2, 80600.0)
    check("SHORT SL hit → EXIT", action == "EXIT")

    # --- Safety Gate ---
    print("\n=== Safety Gate ===")
    safety = MCXSafetyGate(cfg)
    sm_test = MCXSessionManager(cfg)
    dm_test = MCXDataManager(cfg)
    dm_test.register_contract("TEST", "999")
    dm_test.quotes["TEST"].last_price = 100.0
    dm_test.quotes["TEST"].last_update = time.monotonic()

    # If session is not active, should block
    # (depends on current time — check both paths)
    can, reason = safety.can_trade(sm_test, dm_test, {"TEST": {}}, {})
    if sm_test.state in (SessionState.PRE_OPEN, SessionState.CLOSED, SessionState.EVENING_PRE):
        check("Inactive session blocks trading", not can)
    else:
        check("Active session allows trading", can)

    # Circuit breaker blocks
    dm_test._circuit_breaker_until = time.monotonic() + 100
    can, reason = safety.can_trade(sm_test, dm_test, {"TEST": {}}, {})
    check("Circuit breaker blocks", not can and "CIRCUIT" in reason)
    dm_test._circuit_breaker_until = 0

    # --- Strategy Router ---
    print("\n=== Strategy Router ===")
    router = MCXStrategyRouter(cfg)
    fresh_snap = {"breakout": True, "extension_tier": "FRESH"}
    exhausted_snap = {"breakout": True, "extension_tier": "EXHAUSTED"}

    # Create a session in active state
    sm_active = MCXSessionManager(cfg)
    sm_active.state = SessionState.EVENING_ACTIVE
    strat = router.route(fresh_snap, sm_active)
    check("Fresh breakout → ORB_BREAKOUT", strat == MCXStrategy.ORB_BREAKOUT)

    strat = router.route(exhausted_snap, sm_active)
    check("Exhausted → PULLBACK_ENTRY", strat == MCXStrategy.PULLBACK_ENTRY)

    cont_snap = {"breakout": True, "extension_tier": "CONTINUATION_ONLY"}
    strat = router.route(cont_snap, sm_active)
    check("Continuation → MOMENTUM", strat == MCXStrategy.MOMENTUM_CONTINUATION)

    # --- Circuit Breaker ---
    print("\n=== Circuit Breaker ===")
    dm = MCXDataManager(cfg)
    check("Initially no breaker", not dm.circuit_breaker_active)
    for _ in range(3):
        dm.report_429()
    check("After 3x 429 → breaker active", dm.circuit_breaker_active)
    dm.report_success()
    check("After success → breaker cleared", not dm.circuit_breaker_active)

    # --- Summary ---
    print(f"\n{'='*60}")
    print(f"🏁 {passed} PASSED / {failed} FAILED / {passed+failed} TOTAL")
    print(f"{'='*60}")
