                        if side == "LONG" and price_falling:
                            volume_rev = True  # High volume + bearish = reversal for longs
                        elif side == "SHORT" and price_rising:
                            volume_rev = True  # High volume + bullish = reversal for shorts
            
            # Structural invalidation: price beyond SL
            structural_inv = False
            if side == "LONG" and px < float(p["sl"]):
                structural_inv = True
            elif side == "SHORT" and px > float(p["sl"]):
                structural_inv = True
            
            # Candle reversal: 2-bar direction change
            closes = [float(x) for x in df.close.tail(3)]
            candle_rev = False
            if len(closes) >= 3:
                if side == "LONG" and closes[-2] > closes[-3] and closes[-1] < closes[-2]:
