                if avg_vol > 0 and cur_vol > avg_vol * 1.5:
                    # Direction-aware: only reversal if price moving AGAINST position
                    closes_5 = [float(x) for x in df.close.tail(5)] if hasattr(df, "close") else []
                    if len(closes_5) >= 2:
