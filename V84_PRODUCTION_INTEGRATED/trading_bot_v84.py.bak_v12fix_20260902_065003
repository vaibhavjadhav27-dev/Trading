            # Volume reversal: selling/buying surge against position
            volumes = [float(x) for x in df.volume.tail(5)] if hasattr(df, "volume") and len(df) >= 5 else []
            volume_rev = False
            if len(volumes) >= 5:
                avg_vol = sum(volumes) / len(volumes)
