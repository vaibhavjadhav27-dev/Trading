    def _broker_trail_sl(self, sid, p, current_r, px):
        """PATCH_C: Broker-side profit protection.
        Modifies existing Dhan SL order at R milestones:
          <1R: original SL | >=1R: 0.5R | >=2R: 1.25R | >=2.5R: 1.75R | >=3R: 2.25R"""
        sl_order_id = p.get("sl_order_id")
        if not sl_order_id:
            return
        side = p["side"]
        entry = float(p["entry"])
        risk_per_share = max(abs(entry - float(p.get("initial_sl", p["sl"]))), 0.01)
        
        if current_r >= 3.0: protect_r = 2.25
        elif current_r >= 2.5: protect_r = 1.75
        elif current_r >= 2.0: protect_r = 1.25
        elif current_r >= 1.0: protect_r = 0.5
        else: return  # Below 1R, keep original SL
        
        if side == "LONG":
            new_sl = round(entry + protect_r * risk_per_share, 2)
            if new_sl <= float(p["sl"]): return  # Only tighten
        else:
            new_sl = round(entry - protect_r * risk_per_share, 2)
            if new_sl >= float(p["sl"]): return  # Only tighten
        
        try:
            result = modify_pending_sl(self.dhan, sl_order_id, int(p["qty"]), new_sl, side, px)
            if result:
                old_sl = p["sl"]
                p["sl"] = new_sl
                _event("v855_broker_trail", {"symbol": p.get("symbol", sid), "side": side, "current_r": round(current_r, 2), "protect_r": protect_r, "old_sl": old_sl, "new_sl": new_sl})
                log.info("BROKER_TRAIL: %s %s R=%.2f SL: %.2f -> %.2f (protect %.1fR)", p.get("symbol", sid), side, current_r, old_sl, new_sl, protect_r)
        except Exception as e:
            log.error("BROKER_TRAIL FAILED: %s %s — %s", p.get("symbol", sid), side, e)
            _event("v855_broker_trail_fail", {"symbol": p.get("symbol", sid), "error": str(e)})

