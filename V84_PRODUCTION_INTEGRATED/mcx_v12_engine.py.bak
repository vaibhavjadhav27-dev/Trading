_IST_OFFSET = timedelta(hours=5, minutes=30)


def _ist_now() -> datetime:
    return datetime.now(timezone.utc) + _IST_OFFSET


def _ist_time() -> dtime:
    return _ist_now().time()


def _num(v: Any) -> Optional[float]:
    try:
        x = float(v)
        return x if math.isfinite(x) else None
    except (TypeError, ValueError):
        return None


# ============================================================================
# 1. ENUMERATIONS
# ============================================================================

class SessionState(str, Enum):
    PRE_OPEN = "PRE_OPEN"
    MORNING_ORB = "MORNING_ORB"
    MORNING_ACTIVE = "MORNING_ACTIVE"
    AFTERNOON_SELECTIVE = "AFTERNOON_SELECTIVE"
    EVENING_PRE = "EVENING_PRE"
    EVENING_ORB = "EVENING_ORB"
    EVENING_ACTIVE = "EVENING_ACTIVE"
    LATE_SESSION = "LATE_SESSION"
    CLOSED = "CLOSED"


class ExtensionTier(str, Enum):
    FRESH = "FRESH"                         # < 0.5 ATR
    EXTENDED_TRADABLE = "EXTENDED_TRADABLE"  # 0.5 - 0.8 ATR
    CONTINUATION_ONLY = "CONTINUATION_ONLY"  # 0.8 - 1.5 ATR
    EXHAUSTED = "EXHAUSTED"                  # > 1.5 ATR


class MCXStrategy(str, Enum):
    ORB_BREAKOUT = "ORB_BREAKOUT"
    MOMENTUM_CONTINUATION = "MOMENTUM_CONTINUATION"
    PULLBACK_ENTRY = "PULLBACK_ENTRY"
    VWAP_RECLAIM = "VWAP_RECLAIM"
    US_OPEN_REACTION = "US_OPEN_REACTION"


class PositionState(str, Enum):
    INITIAL = "INITIAL"
    PROVEN = "PROVEN"
    PROFIT = "PROFIT"
    RUNNER = "RUNNER"


class AuditEvent(str, Enum):
    SESSION_START = "SESSION_START"
    SESSION_TRANSITION = "SESSION_TRANSITION"
    CONTRACT_RESOLVED = "CONTRACT_RESOLVED"
    ORB_COMPLETE = "ORB_COMPLETE"
    SIGNAL_DETECTED = "SIGNAL_DETECTED"
    ENTRY_DECISION = "ENTRY_DECISION"
    POSITION_OPEN = "POSITION_OPEN"
    SL_PLACED = "SL_PLACED"
    TRAIL_UPDATED = "TRAIL_UPDATED"
    EXIT_SIGNAL = "EXIT_SIGNAL"
    POSITION_CLOSED = "POSITION_CLOSED"
    SESSION_END = "SESSION_END"
    DATA_STALE = "DATA_STALE"
    CIRCUIT_BREAKER = "CIRCUIT_BREAKER"
    HEARTBEAT = "HEARTBEAT"
    CONTRACT_REJECTED = "CONTRACT_REJECTED"
    EXECUTION_QUALITY_REJECTED = "EXECUTION_QUALITY_REJECTED"


