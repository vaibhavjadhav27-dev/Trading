                _drift_pct = abs(_fresh_ltp - price) / price * 100.0
                if _drift_pct > 0.30:
                    log.warning(f"PRICE_REVALIDATION FAIL: {c.get('symbol','?')} drift={_drift_pct:.2f}% (signal={price:.2f} live={_fresh_ltp:.2f})")
                    return False, f"PRICE_DRIFT_{_drift_pct:.1f}pct"
                log.info(f"PRICE_REVALIDATION OK: {c.get('symbol','?')} drift={_drift_pct:.3f}%")
        except Exception as _rv_e:
            log.warning(f"Price revalidation skipped: {_rv_e}")
        resp=self.dhan.place_order(sid,qty,0,txn,"MARKET");oid=(resp or {}).get("orderId") if isinstance(resp,dict) else None
        if not oid:return False,"dhan_order_not_accepted"
        fill=self.dhan.verify_fill(oid)
        if fill["status"]=="PARTIAL":
            try:self.dhan.cancel_order(oid)
            except Exception:pass
