    def _daily_allowed(self):
        bal=max(float(self.dhan.get_balance() or 0),1.0)
        realized=float(self.v84_risk.get("realized_pnl",0.0) or 0)
        # V10.1-R: include UNREALISED P&L from open positions (broker-truth MTM)
        unrealized=0.0
        try:
            for _p in self.active_positions.values():
                _px=float(self.fetch_ltp_concurrent([str(_p["security_id"])]).get(str(_p["security_id"]),_p.get("entry",0)) or _p.get("entry",0))
                _entry=float(_p.get("entry",0) or 0); _qty=int(_p.get("qty",0) or 0)
                if _p.get("side")=="LONG": unrealized += (_px-_entry)*_qty
                else: unrealized += (_entry-_px)*_qty
        except Exception as _ue:
            log.warning(f"unrealised P&L calc failed: {_ue}")
        total_pnl=realized+unrealized
        pnl_pct=total_pnl/bal*100
        if pnl_pct<=-RISK.daily_hard_stop_pct:return False,"DAILY_HARD_STOP"
        # V10.1-R: 2% account gate uses realised + unrealised. Consecutive-loss REMOVED.
        if pnl_pct<=-RISK.daily_soft_stop_pct:return False,f"DAILY_SOFT_STOP(r={realized:.0f}+u={unrealized:.0f}={pnl_pct:.2f}%)"
        return True,"OK"

    def _v10r_gate(self, d, f, c):
        """V10.1-R canonical authority: veto (anti-chase) + sizing (30%/100%).

        Layered on V8 final_decision(). Never places orders itself — only
        modifies the decision dict `d` that flows to the existing V851 path.
        """
        try:
            from V10_1_STRATEGY_PATCH import classify_move_stage, MoveStage, Snapshot
        except Exception as _ie:
            log.warning(f"V10.1-R gate import failed ({_ie}) — passing V8 decision through")
            return d

        if not isinstance(d, dict) or d.get("status") != "ENTER":
            return d

        side = d.get("side", "LONG")
        direction = "BUY" if side == "LONG" else "SELL"
        sym = c.get("symbol", "?")

        # 1) Hard universe gate: Rs60-3500 + >=100K volume/ADV
        ltp = float(f.get("ltp", c.get("ltp", 0)) or 0)
        if ltp < 60.0 or ltp > 3500.0:
            log.info(f"V10R VETO {sym}: PRICE_OUTSIDE_60_3500 ({ltp:.2f})")
            return {"status": "WATCH", "reason": "V10R_PRICE_GATE", "symbol": sym}
        _today_vol = 0
        try:
            _df = f.get("df")
            if _df is not None and "volume" in _df.columns:
                _today_vol = int(_df["volume"].sum())
        except Exception:
            pass
        _adv = int(f.get("avg_daily_volume", c.get("adv_20d", 0)) or 0)
        if max(_today_vol, _adv) < 100000:
            log.info(f"V10R VETO {sym}: VOLUME_LT_100K (today={_today_vol} adv={_adv})")
            return {"status": "WATCH", "reason": "V10R_VOLUME_GATE", "symbol": sym}

        # 2) Fresh-quote drift check: 0.30% absolute AND 0.35 ATR
        signal_price = float(d.get("entry_price", ltp) or ltp)
        decision_price = ltp  # ltp was fetched fresh in _build_entry_features
        atr_abs = 0.0
        try:
            _df = f.get("df")
            if _df is not None and len(_df) >= 15:
                import v82_strategy as _v82
                # ATR proxy: mean high-low of last 14 bars
                _hl = (_df["high"] - _df["low"]).tail(14)
                atr_abs = float(_hl.mean()) if len(_hl) else 0.0
        except Exception:
            atr_abs = 0.0

        if signal_price > 0:
            drift_pct = abs(decision_price - signal_price) / signal_price * 100.0
            if drift_pct > 0.30:
                log.info(f"V10R VETO {sym}: DRIFT_0.30pct ({drift_pct:.3f}%)")
                return {"status": "WATCH", "reason": "V10R_DRIFT_ABS", "symbol": sym}
        if atr_abs > 0:
            drift_atr = abs(decision_price - signal_price) / atr_abs
            if drift_atr > 0.35:
                log.info(f"V10R VETO {sym}: DRIFT_0.35ATR ({drift_atr:.2f})")
                return {"status": "WATCH", "reason": "V10R_DRIFT_ATR", "symbol": sym}

        # 3) Build Snapshot for move-stage classification
        try:
            from datetime import datetime as _dt
            snap = Snapshot(
                symbol=sym, ts=_dt.now(), price=decision_price,
                atr=atr_abs if atr_abs > 0 else max(decision_price * 0.005, 0.01),
                vwap=float(f.get("vwap", c.get("vwap", decision_price)) or decision_price),
                adx=float(f.get("adx", c.get("adx", 20)) or 20),
                rvol=float(f.get("rvol", 1) or 1),
                momentum_5m=float(f.get("momentum_5m", 0) or 0),
                momentum_15m=float(f.get("momentum_15m", 0) or 0),
                sector_rs=float(f.get("sector_rs", 0) or 0),
                stock_rs=float(f.get("rs", c.get("rs", 0)) or 0),
                volume_acceleration=float(f.get("accel", f.get("volume_acceleration", 0)) or 0),
                orb_high=f.get("orb_high", c.get("orb_high")),
                orb_low=f.get("orb_low", c.get("orb_low")),
            )
            stage = classify_move_stage(snap, direction)
        except Exception as _se:
            log.warning(f"V10R stage calc failed for {sym}: {_se} — passing through")
            return d

        # 4) Apply veto + sizing
        d["move_stage"] = stage.value if hasattr(stage, "value") else str(stage)
        if stage == MoveStage.EXHAUSTED:
            log.info(f"V10R VETO {sym}: EXHAUSTED (anti-chase)")
            return {"status": "WATCH", "reason": "V10R_EXHAUSTED", "symbol": sym,
                    "move_stage": d["move_stage"]}
        elif stage == MoveStage.EARLY_ENTRY:
            d["position_pct"] = 0.30
            d["entry_type"] = "EARLY"
            log.info(f"V10R EARLY {sym}: 30% starter (developed but strong)")
        else:
            d["position_pct"] = 1.0
            d["entry_type"] = "NORMAL"
        return d

