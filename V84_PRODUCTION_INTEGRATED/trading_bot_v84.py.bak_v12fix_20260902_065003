            # PATCH B: Real-time exit snapshot (fresh RS, RVOL, volume reversal, structural)
            vw = vwap(df)
            from v82_strategy import momentum as calc_momentum
            m5, m15, m30, accel = calc_momentum(df)
            
            # Fresh RVOL
            # RVOL: calculate from df directly (avg_daily_volume not stored in position)
            # Fresh RVOL from intraday volume bars
            volumes = [float(x) for x in df.volume.tail(20)] if hasattr(df, "volume") and len(df) >= 20 else []
            rv = (volumes[-1] / (sum(volumes[:-1]) / max(len(volumes)-1, 1))) if len(volumes) >= 5 and sum(volumes[:-1]) > 0 else 1.0
            
            # Fresh RS: stock vs NIFTY relative strength
            nifty_px = float(getattr(self, "_nifty_ltp", 0) or 0)
            nifty_vwap = float(getattr(self, "_nifty_vwap", 0) or 0)
